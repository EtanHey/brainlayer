#!/usr/bin/env bash
# Pre-push hook — regression harness gate
#
# NOT FRICTION — discipline. The 5-day regression cycle in this repo
# exists because past pushes bypassed checks. This hook stops that.
#
# DO NOT BYPASS:
#   git push --no-verify          ← sneaks past the hook
#   chmod -x .githooks/pre-push   ← disables it
#
# DO NOT SILENCE FAILURES:
#   A failing test = a real bug. The Zero-RMS Hang recurred Apr 2 → Apr 27
#   because symptomatic fixes shipped without root-cause coverage.
#   Treat each failure as CRITICAL REVIEW TIME.

set -uo pipefail
[ ! -f scripts/run_tests.sh ] && { echo "⚠️  no scripts/run_tests.sh — skipping"; exit 0; }

# --- scope a TAG push ---------------------------------------------------------
# git hands a pre-push hook its refs on STDIN, one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
# This hook threw that away, so nothing downstream could know a tag was being pushed. A tag has no
# branch to diff against, so `git push origin v1.5.14` fell through to the DEFAULT scope: the whole
# 4,386-test suite, on the M4 Etan is working on — exactly what changed-only exists to avoid. A
# tag's content is one range, previous tag..this tag, so resolve it and say so.
#
# Every narrowing here is conservative, and every refusal to narrow is LOUD:
#   - a branch anywhere in the push wins (it carries changes no tag range covers)
#   - an explicit BRAINLAYER_PREPUSH_SCOPE is the operator's decision — explicit beats default
#   - an explicit BRAINLAYER_CHANGED_FILES/_RANGE, likewise
#   - more than one tag in one push has no single range
#   - a tag with no previous RELEASE tag has no range at all
# In all five the scope is left exactly as the caller set it, and the reason is printed instead of
# paid for silently.
tag_count=0
non_tag_refs=0
tag_name=""
if [ ! -t 0 ]; then
  # `[ ! -t 0 ]` so a hand-run of this hook does not block reading a terminal.
  while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_ref" ] && continue
    case "$local_sha" in
      # An all-zero LOCAL sha is a DELETION: it ships no content, so there is nothing to test.
      *[!0]*) ;;
      *) continue ;;
    esac
    case "$local_ref" in
      refs/tags/*) tag_count=$((tag_count + 1)); tag_name="${local_ref#refs/tags/}" ;;
      *) non_tag_refs=$((non_tag_refs + 1)) ;;
    esac
  done
fi

if [ "$tag_count" -gt 0 ]; then
  if [ "$non_tag_refs" -gt 0 ]; then
    # This case used to skip the whole block, so it refused to narrow WITHOUT saying why -- safe,
    # but the loudness guarantee above was false for it.
    echo "WARNING: pre-push: a branch is in this push alongside $tag_count tag(s)."
    echo "WARNING: it carries changes no tag range covers; leaving the scope as the caller set it."
  elif [ -n "${BRAINLAYER_PREPUSH_SCOPE:-}" ]; then
    # `BRAINLAYER_PREPUSH_SCOPE=full git push origin vX` is a deliberate full-suite tag push, and
    # narrowing it would defeat the operator on the very gate this scoping hardens. Explicit beats
    # default, in BOTH directions: an explicit changed-only is not second-guessed with a range
    # either. Absent means default (`full` in run_tests.sh), which is what this block may narrow.
    echo "==> pre-push: BRAINLAYER_PREPUSH_SCOPE=$BRAINLAYER_PREPUSH_SCOPE was set explicitly — leaving it alone"
  elif [ -n "${BRAINLAYER_CHANGED_FILES:-}" ] || [ -n "${BRAINLAYER_CHANGED_FILES_RANGE:-}" ]; then
    echo "==> pre-push: tag push with an explicit changed set already set — leaving it alone"
  elif [ "$tag_count" -ne 1 ]; then
    echo "WARNING: pre-push: $tag_count tags in one push — no single range to scope from."
    echo "WARNING: running the FULL suite; push tags one at a time to scope them."
  # --match 'v*' is load-bearing: bare `describe --tags` answers with the nearest reachable tag of
  # ANY name, so one intervening nightly/rc/checkpoint on the release line would start the range
  # there and never map the commits between it and the real previous release. This repo already
  # carries non-v* tags (`pre-rename`, `archive/*`). Under-scoping a gate is fail-open; a release
  # tag is the only predecessor whose range means "what this release ships".
  elif previous_tag="$(git describe --tags --abbrev=0 --match 'v*' "${tag_name}^" 2>/dev/null)" &&
    [ -n "$previous_tag" ]; then
    echo "==> pre-push: tag $tag_name scoped to $previous_tag..$tag_name (not the full suite)"
    export BRAINLAYER_PREPUSH_SCOPE=changed-only
    export BRAINLAYER_CHANGED_FILES_RANGE="$previous_tag..$tag_name"
  else
    echo "WARNING: pre-push: tag $tag_name has no previous release tag (v*) to diff against."
    echo "WARNING: running the FULL suite. Loud, not narrowed on a guess."
  fi
fi

BRAINLAYER_PREPUSH=1 bash scripts/run_tests.sh
exit_status=$?

if [ $exit_status -ne 0 ]; then
  cat <<'BANNER'

🛑 PUSH BLOCKED — regression harness failed.

This is a real regression. DO NOT bypass with --no-verify or silence the test.
  1. Read the failure carefully
  2. Reproduce locally
  3. Fix the underlying bug
  4. If the test IS wrong, separate PR with rationale

The 5-day regression cycle exists because past pushes bypassed checks.

BANNER
  exit $exit_status
fi

exit 0
