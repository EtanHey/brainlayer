<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- NOT AUTHORITATIVE: scripts/launchd/ holds the templated plists that
     scripts/launchd/install.sh actually installs. This copy is kept for reference only.
     R3 (2026-09-04): its ProgramArguments pointed at the pip install
     (/Library/Frameworks/Python.framework/.../bin/brainlayer, 1.5.11), violating the
     "served from the keg" constraint. Repointed at the Homebrew keg. -->
<dict>
    <key>Label</key>
    <string>com.brainlayer.watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/brainlayer</string>
        <string>watch</string>
        <string>--poll</string>
        <string>30</string>
        <string>--batch-size</string>
        <string>10</string>
        <string>--flush-ms</string>
        <string>500</string>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/etanheyman/Library/Logs/brainlayer/watch.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/etanheyman/Library/Logs/brainlayer/watch.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/etanheyman/.local/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>AXIOM_TOKEN</key>
        <string></string>
    </dict>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>Nice</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
