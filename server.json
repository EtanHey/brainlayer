{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.etanhey/brainlayer",
  "title": "BrainLayer",
  "description": "Persistent local memory for AI agents \u2014 semantic search, knowledge graph, and 16 BrainBar MCP tools with ToolAnnotations over SQLite.",
  "version": "1.5.49",
  "websiteUrl": "https://brainlayer.etanheyman.com",
  "repository": {
    "url": "https://github.com/EtanHey/brainlayer",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "brainlayer",
      "version": "1.5.49",
      "runtimeHint": "pipx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BRAINLAYER_DB",
          "description": "Path to SQLite database file (default: ~/.local/share/brainlayer/brainlayer.db)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
