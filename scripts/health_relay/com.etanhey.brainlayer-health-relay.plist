<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Independent health relay. Rendered by hand (docs/operations/health-relay.md), never by
     scripts/launchd/install.sh. com.etanhey.* keeps it out of the fleet watchdog's
     com.brainlayer.* revival glob and out of the supervisor's job manifest. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.etanhey.brainlayer-health-relay</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-I</string>
        <string>__SCRIPT__</string>
        <string>--config</string>
        <string>__CONFIG__</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/health-relay.err.log</string>
</dict>
</plist>
