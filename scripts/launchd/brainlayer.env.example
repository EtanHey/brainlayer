# BrainLayer private config.
# Install path: ~/.config/brainlayer/brainlayer.env
# Keep this file mode 0600.
#
# Preferred: use a 1Password CLI reference so the key is not written literally.
# GOOGLE_API_KEY="$(op read 'op://Private/Google AI/Gemini API key')"
#
# Older installed hotlane jobs still require this key until release.
# Plain-env fallback:
GOOGLE_API_KEY=

# Global system gate for launchd-managed BrainLayer jobs.
BRAINLAYER_SYSTEM_ENABLED=1

# Disabled KeepAlive jobs sleep instead of tight-restarting.
BRAINLAYER_DISABLED_SLEEP_SECONDS=3600

# Optional exact-condition notification suppressions. The JSON shape is:
# {"conditions":{"tier0:state_stale":"planned health-check maintenance"}}
# BRAINLAYER_BY_DESIGN_REASON_FILE=~/.local/share/brainlayer/by-design-notifications.json
# Per-launchd-job gates.
BRAINLAYER_LAUNCHD_HOTLANE_ENABLED=1
BRAINLAYER_LAUNCHD_DECAY_ENABLED=1
BRAINLAYER_LAUNCHD_DRAIN_ENABLED=1
BRAINLAYER_LAUNCHD_WATCH_ENABLED=1
BRAINLAYER_LAUNCHD_INDEX_ENABLED=1
BRAINLAYER_LAUNCHD_BACKUP_DAILY_ENABLED=1
BRAINLAYER_LAUNCHD_JSONL_BACKUP_ENABLED=1
BRAINLAYER_LAUNCHD_MAINTENANCE_NIGHTLY_ENABLED=1
BRAINLAYER_LAUNCHD_MAINTENANCE_WEEKLY_ENABLED=1
# BRAINLAYER_MAINTENANCE_KEEP_DOWN=watch,drain
BRAINLAYER_LAUNCHD_REPAIR_FTS_ENABLED=1
BRAINLAYER_LAUNCHD_WAL_CHECKPOINT_ENABLED=1
