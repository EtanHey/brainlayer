{
  "description": "BrainBar: F4 toggle",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "f4",
        "modifiers": {
          "optional": [
            "any"
          ]
        }
      },
      "to": [
        {
          "shell_command": "touch /tmp/.brainbar-toggle"
        }
      ]
    }
  ]
}
